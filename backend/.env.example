# 复制为 .env 后填写。没有 AI_API_KEY 时，解析/画像/评分会自动回退到规则实现。
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/ai_talent?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=mvp1-dev-secret-change-me-in-prod

# AI 网关（OpenAI 兼容）
AI_ENABLED=1
AI_BASE_URL=http://127.0.0.1:3065/v1
AI_MODEL=deepseek-v4.1-flash-solo
AI_API_KEY=
AI_TIMEOUT=60
